{
  "name": "portfolio-template",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cv:generate": "tsx scripts/generate-cvs.tsx",
    "data:validate": "tsx scripts/validate-data.ts",
    "prebuild": "npm run data:validate && npm run cv:generate",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
